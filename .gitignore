# ============================================================
# VeriFind AI — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# --- Virtual environments ---
.venv/
venv/
ENV/
env/
.python-version

# --- Secrets & Environment variables (NEVER commit these) ---
.env
.env.local
.env.production
.env.staging
*.secret
*.secret.yaml
*.key
secrets/

# --- Streamlit ---
.streamlit/secrets.toml
.streamlit/credentials.toml

# --- Playwright / Browser ---
test-results/
playwright-report/
.playwright/
# Playwright browser binaries (huge, re-downloaded via `playwright install`)
ms-playwright/

# --- Build & Distribution ---
build/
dist/
*.egg-info/
.eggs/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
htmlcov/
junit/
*.xml

# --- IDEs & System ---
.DS_Store
.idea/
.vscode/
*.swp
*~
Thumbs.db

# --- Vercel ---
.vercel/

# --- Logs ---
*.log
logs/
