# Environment Configuration Example for VeriFind AI
# Copy this file to .env and configure local values

# App Environment (development, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Web Navigation & Scraping Limits
MAX_SEARCH_RESULTS=5
REQUEST_TIMEOUT_SECONDS=15
PLAYWRIGHT_HEADLESS=true
USER_AGENT=VeriFindAI-Agent/0.1.0 (+https://github.com/amd-ai-league)

# AI Engine / Reasoning Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AMD ROCm / Local Inference Backend (future phase)
ROCM_INFERENCE_ENDPOINT=

