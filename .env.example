# ============================================================
# VeriFind AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file itself — it's in .gitignore.
# ============================================================

# ----- Application -----
ENVIRONMENT=development
LOG_LEVEL=INFO

# ----- Backend API -----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ----- Web Navigation -----
MAX_SEARCH_RESULTS=5
REQUEST_TIMEOUT_SECONDS=15
PLAYWRIGHT_HEADLESS=true
USER_AGENT=VeriFindAI-Agent/0.3.0

# ----- Serverless mode (auto-set by Vercel, do NOT set locally) -----
# VERIFIND_SERVERLESS=true

# ----- AI Provider selection -----
# Options: gemini | amd_rocm | openai_compatible
MODEL_PROVIDER=gemini

# ----- Google Gemini (default dev provider) -----
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ----- AMD ROCm / Developer Cloud -----
ROCM_INFERENCE_ENDPOINT=http://localhost:8000/v1
ROCM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
ROCM_API_KEY=

# ----- OpenAI-compatible endpoint -----
OPENAI_COMPATIBLE_ENDPOINT=http://localhost:8000/v1
OPENAI_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
